#include <iostream>
using namespace std;

int main() {
    int n;
    
    cout << "Enter number of elements: ";
    cin >> n;

    if (n <= 0) {
        cout << "Invalid input!" << endl;
        return 0;
    }

    double num, max;

    cout << "Enter numbers:\n";
    cin >> max;

    for (int i = 2; i <= n; i++) {
        cin >> num;
        if (num > max) {
            max = num;
        }
    }

    cout << "Maximum value = " << max << endl;

    return 0;
}
